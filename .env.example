# Auth server (kerits OAuth provider)
VITE_AS_URL=https://oauth.kerits.id
# GitHub bridge origin, e.g. https://github-bridge.kerits.id
VITE_BRIDGE_URL=
# Optional defaults for the Config repo (owner/repo) and branch; empty = the token supplies them
VITE_REPO=
VITE_BRANCH=
# Optional JSON RequestEntry[]; empty uses the placeholder member entry (audience = VITE_BRIDGE_URL)
VITE_ENTRIES=
